PokemonCustomPulseAura < PanelOutline
  phantom: false
  focusable: true
  border-color: #5C5C5C
  background-color: #2F2F2F

  $hover:
    border-color: #767676
    background-color: #383838

  $focus:
    border-color: #8A8A8A
    background-color: #404040

  PanelRoundedSolid
    id: color
    anchors.fill: parent
    image-color: #626262
    margin: 5
    border-color: #686868
    background-color: #3A3A3A

  UIWidget
    id: locked
    anchors.centerIn: parent
    image-source: /images/game/console/icon_lock
    phantom: true

PokemonCustomShaderGrid < UIScrollArea
  layout:
    type: grid
    cell-size: 58 58
    cell-spacing: 5
    flow: true

Panel
  id: shadersPanel
  background-color: #242424

  ComboBoxGame
    id: category
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    @onSetup: |
      self:addOption(tr('Pulse Aura'))

  PokemonCustomShaderGrid
    id: list
    anchors.top: category.bottom
    anchors.left: parent.left
    anchors.right: scroll.left
    anchors.bottom: parent.bottom
    margin-top: 10
    vertical-scrollbar: scroll

  VerticalScrollBar
    id: scroll
    anchors.top: category.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    pixels-scroll: true
    visible: false
    margin-top: 10