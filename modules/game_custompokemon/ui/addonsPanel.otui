PokemonCustomAddon < PanelRoundedSolid
  image-color: #3F3F3F
  phantom: false
  focusable: true
  padding: 10
  border-color: #5B5B5B
  background-color: #313131

  $hover:
    border-color: #777777
    background-color: #383838

  $focus:
    border-color: #8A8A8A
    background-color: #3F3F3F

  Creature
    id: outfit
    size: 56 56
    anchors.centerIn: parent
    margin-top: 5
    phantom: true

  UIWidget
    id: locked
    anchors.top: parent.top
    anchors.right: parent.right
    image-source: /images/game/icons/icon_lock
    image-color: #A8A8A8
    margin: -8
    phantom: true

PokemonCustomAddonGrid < UIScrollArea
  layout:
    type: grid
    cell-size: 78 92
    cell-spacing: 5
    flow: true

Panel
  id: addonsPanel
  background-color: #242424

  PokemonCustomAddonGrid
    id: list
    anchors.fill: parent
    anchors.right: next.left
    vertical-scrollbar: scroll

  VerticalScrollBar
    id: scroll
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    pixels-scroll: true
    visible: false