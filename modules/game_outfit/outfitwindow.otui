OutfitButtonBox < UICheckBox
  size: 26 22
  text-align: center
  text-offset: 0 2
  font: verdana-11px-antialised
  color: #ffffff
  background-color: #34b7c0
  border-width: 1
  border-color: #2a97a3
  change-cursor-image: true
  cursor: pointer

  $hover !checked:
    background-color: #45c6cf

  $checked:
    background-color: #d73737
    border-color: #b52b2b

  $disabled:
    color: #ffffff88
    background-color: #34b7c088
    border-color: #2a97a388
    change-cursor-image: false

OutfitActionButton < UIButton
  size: 34 22
  text-align: center
  text-offset: 0 2
  font: verdana-11px-antialised
  color: #ffffff
  background-color: #34b7c0
  border-width: 1
  border-color: #2a97a3
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    background-color: #45c6cf

  $pressed:
    background-color: #2a97a3
    text-offset: 1 3

  $disabled:
    color: #ffffff88
    background-color: #34b7c088
    border-color: #2a97a388
    change-cursor-image: false

PaginationButton < UIButton
  size: 20 20
  image-source: /images/ui/button_page
  image-color: #ffffff
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-color: #d7f6ff

  $pressed:
    image-color: #8bd9ec

  $disabled:
    image-color: #ffffff66
    change-cursor-image: false

PaginationLeftButton < PaginationButton
  image-clip: 0 0 20 20

PaginationRightButton < PaginationButton
  image-clip: 20 0 20 20

OutfitBox < Panel
  border-width: 1
  border-color: #5a5a5a
  background-color: #2b2b2b
  phantom: false
  focusable: true
  padding: 10

  $focus:
    border-color: #057FFA

  UICreature
    id: outfit
    anchors.fill: parent
    margin-top: 5
    phantom: true

  UIWidget
    id: lock
    anchors.top: parent.top
    anchors.right: parent.right
    image-source: /images/game/icons/icon_lock
    image-color: #979797
    margin: -8
    phantom: true

OutfitList < Panel
  id: outfitList
  anchors.top: parent.top
  anchors.bottom: leftFooterPanel.top
  anchors.left: parent.left
  anchors.right: parent.horizontalCenter
  margin: 32 10 12 0

  layout:
    type: grid
    cell-size: 63 80
    cell-spacing: 2
    flow: true
    num-columns: 3
    num-lines: 3

LeftFooterPanel < UIWidget
  id: leftFooterPanel
  height: 32
  anchors.bottom: parent.bottom
  anchors.left: parent.left
  anchors.right: parent.horizontalCenter

PagePanel < UIWidget
  id: pagePanel
  size: 150 20
  anchors.centerIn: parent

  Button
    id: firstPage
    visible: false
    @onClick: modules.game_outfit.firstPage()

  PaginationLeftButton
    id: prevPage
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: page.left
    margin-right: 18
    @onClick: modules.game_outfit.prevPage()

  Label
    id: page
    anchors.centerIn: parent
    width: 54
    text-align: center
    font: verdana-11px-antialised

  PaginationRightButton
    id: nextPage
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: page.right
    margin-left: 18
    @onClick: modules.game_outfit.nextPage()

  Button
    id: lastPage
    visible: false
    @onClick: modules.game_outfit.lastPage()

OutfitPanel < UIWidget
  id: outfitPanel
  width: 316
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  anchors.right: parent.right
  anchors.left: parent.horizontalCenter
  margin: 0 0 8 10
  padding: 10

  CheckBox
    id: addon
    size: 15 15
    anchors.top: outfit.top
    anchors.left: outfit.right
    margin-top: 25
    margin-left: 5
    checked: false
    visible: false
    !tooltip: tr('Addon')

  Label
    id: name
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    text-auto-resize: true
    font: verdana-11px-antialised

  UICreature
    id: outfit
    size: 75 75
    anchors.top: name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 18

  OutfitActionButton
    id: animateButton
    size: 34 22
    anchors.left: randomButton.right
    anchors.bottom: randomButton.bottom
    margin-left: 4
    text: "A"
    !tooltip: tr('Walking')
    @onClick: modules.game_outfit.setOutfitAnimation(self)

  OutfitActionButton
    id: randomButton
    size: 34 22
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: colorBoxPanel.top
    margin-bottom: 16
    text: "?"
    !tooltip: tr('Randomize')
    @onClick: modules.game_outfit.randomize()

  OutfitActionButton
    id: rotateButton
    size: 34 22
    anchors.right: randomButton.left
    anchors.bottom: randomButton.bottom
    margin-right: 4
    text: "R"
    !tooltip: tr('Rotate')
    @onClick: modules.game_outfit.setOutfitRotate()

  UIWidget
    id: template
    size: 116 22
    anchors.bottom: randomButton.top
    anchors.horizontalCenter: randomButton.horizontalCenter
    margin-bottom: 10

    OutfitButtonBox
      id: head
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      !tooltip: tr('Head')
      text: "1"
      checked: true

    OutfitButtonBox
      id: primary
      anchors.bottom: prev.bottom
      anchors.left: prev.right
      margin-left: 4
      !tooltip: tr('Primary')
      text: "2"

    OutfitButtonBox
      id: secondary
      anchors.bottom: prev.bottom
      anchors.left: prev.right
      margin-left: 4
      !tooltip: tr('Secondary')
      text: "3"

    OutfitButtonBox
      id: detail
      anchors.bottom: prev.bottom
      anchors.left: prev.right
      margin-left: 4
      !tooltip: tr('Detail')
      text: "4"

  Panel
    id: colorBoxPanel
    height: 112
    anchors.bottom: confirm.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 12
    layout:
      type: grid
      cell-size: 16 16
      num-columns: 19
      num-lines: 7

  Button
    id: confirm
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    anchors.left: parent.left
    !text: tr('Use')
    @onClick: modules.game_outfit.accept()

MainWindow
  size: 700 490
  focusable: false
  !text: tr('Select Outfit')
  @onEnter: modules.game_outfit.accept()
  @onEscape: modules.game_outfit.destroy()
  @onClose: modules.game_outfit.destroy()

  OutfitList
  LeftFooterPanel
    PagePanel
  OutfitPanel

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 8
    size: 15 15
    image-source: /images/ui/miniwindow_buttons
    image-clip: 30 0 15 15
    @onClick: modules.game_outfit.destroy()

    $hover:
      image-clip: 30 15 15 15

    $pressed:
      image-clip: 30 30 15 15
