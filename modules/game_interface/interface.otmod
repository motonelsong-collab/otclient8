Module
  name: game_interface
  description: Create the game interface, where the ingame stuff starts
  author: OTClient team
  website: https://github.com/edubart/otclient
  dependencies: [ client_styles, client_topmenu ]
  sandboxed: true
  scripts: [ widgets/uigamemap, gameinterface ]
  load-later:
    - game_buttons
    - game_hotkeys
    - game_textmessage
    - game_chat
    - game_outfit
    - game_inventory
    - game_containers
    - game_viplist
    - game_battle
    - game_minimap
    - game_npctrade
    - game_textwindow
    - game_playertrade
    - game_bugreport
    - game_playerdeath
    - game_playermount
    - game_ruleviolation
    - game_market
    - game_spelllist
    - game_cooldown
    - game_modaldialog
    - game_unjustifiedpoints
    - game_walking
    - game_shop
    - game_itemselector
    - client_textedit
    - client_profiles
    - game_actionbar
    - game_prey
    - game_imbuing
    - game_stats
    - game_shaders
    - game_pokemoves
    - game_autoloot
    - game_effects
    - game_pokebar
    - game_health
    - game_pokemon
    - game_dex
    - game_pokeinicial
    - game_npcdialog
    - game_dailyreward
    - game_notification
    - game_custompokemon
    - game_cam
    - game_tv
  @onLoad: init()
  @onUnload: terminate()